---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/style.css';
import { altPath, href, ui, type Locale } from '../i18n';
import { SITE, profile } from '../data/site';
import { projects, projectIds } from '../data/projects';
import { skills, skillIds } from '../data/skills';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  /** Structured data for search engines (JSON-LD). */
  jsonLd?: object;
  /** Design preview (/lab/): sets data-dir on <html> and keeps the page out of search engines. */
  dir?: 'a' | 'b' | 'c';
}
const { locale, title, description, image = '/og.jpg', jsonLd, dir } = Astro.props;
const t = ui[locale];
const alt = altPath(Astro.url.pathname);
const other: Locale = locale === 'en' ? 'fr' : 'en';
const canonical = new URL(Astro.url.pathname, SITE).href;
/** JSON for <script> data blocks: escape `<` so the content can never close the tag. */
const json = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');

/** Strict CSP, production only (the dev server injects inline styles). */
const csp = [
  "default-src 'self'", "script-src 'self'", "style-src 'self'", "img-src 'self' data:", "font-src 'self'",
  "connect-src 'self'", "object-src 'none'", "base-uri 'self'", "media-src 'self'", "form-action 'self' mailto:",
  'upgrade-insecure-requests',
].join('; ');

const commands = [
  { label: t.nav.work, go: href(locale, '/#work') },
  { label: t.nav.servicenow, go: href(locale, '/servicenow/') },
  { label: t.nav.skills, go: href(locale, '/skills/') },
  { label: t.nav.how, go: href(locale, '/how-i-work/') },
  { label: t.nav.contact, go: href(locale, '/#contact') },
  ...projectIds.map((id) => ({ label: projects[id].title, go: href(locale, `/projects/${id}/`) })),
  ...skillIds.map((id) => ({ label: skills[id].name, go: href(locale, `/skills/${id}/`) })),
  { label: t.langName, go: alt[other] },
  { label: 'GitHub', go: profile.github },
];
---
<!doctype html>
<html lang={locale} data-dir={dir}>
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {dir && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080c" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(alt.en, SITE).href} />
    <link rel="alternate" hreflang="fr" href={new URL(alt.fr, SITE).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.en, SITE).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE).href} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={json(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="nav" id="top">
      <a class="brand" href={href(locale, '/')} aria-label={t.home}><span class="brand-mark">AT</span><span class="brand-name">{profile.name}</span></a>
      <nav aria-label="Primary">
        <a href={href(locale, '/#work')}>{t.nav.work}</a>
        <a href={href(locale, '/servicenow/')}>{t.nav.servicenow}</a>
        <a href={href(locale, '/skills/')}>{t.nav.skills}</a>
        <a href={href(locale, '/how-i-work/')}>{t.nav.how}</a>
        <a href={href(locale, '/#contact')}>{t.nav.contact}</a>
      </nav>
      <div class="nav-tools">
        <a class="lang" href={alt[other]} hreflang={other} lang={other} aria-label={t.langSwitch}>{other.toUpperCase()}</a>
        <button class="kbd-btn" id="open-palette" type="button" aria-haspopup="dialog" aria-label={t.openPalette}><kbd>⌘</kbd><kbd>K</kbd></button>
      </div>
    </header>

    {dir && (
      <nav class="lab-switch" aria-label="Design directions">
        {(['a', 'b', 'c'] as const).map((d) => <a href={href(locale, `/lab/direction-${d}/`)} aria-current={d === dir ? 'page' : undefined}>{d.toUpperCase()}</a>)}
      </nav>
    )}
    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p>© {new Date().getFullYear()} {profile.name}. {t.footer}</p>
      {dir && <p>{t.hdriCredit}</p>}
      <a href="#top">{t.backTop}</a>
    </footer>

    <dialog class="palette" id="palette" aria-label={t.paletteLabel}>
      <form method="dialog" class="palette-inner">
        <input id="palette-input" type="text" placeholder={t.palette} autocomplete="off" aria-label={t.paletteLabel} />
        <ul id="palette-list" role="listbox"></ul>
      </form>
    </dialog>
    <script type="application/json" id="palette-data" is:inline set:html={json(commands)} />
    <script>
      import '../scripts/common';
    </script>
  </body>
</html>
